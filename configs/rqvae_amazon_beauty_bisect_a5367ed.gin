import data.processed
import modules.quantize

# Bisect variant for commit a5367ed (Restore SiLU + L2 output norm). That commit
# switched the encoder/decoder MLP activation from ReLU to SiLU and flipped the
# decoder's final L2-normalisation on. Neither is captured in the saved
# RqVae model_config (they are not constructor kwargs as of that era), so the
# "match Beauty arch" justification cannot be verified from the healthy ckpt.
# This config runs the same Beauty recipe as rqvae_amazon_beauty.gin but with
# a5367ed's two edits reverted, so the 5k-step VQ-loss curve can be compared
# against the baseline to see whether that commit is the repro3 collapse cause.

train.iterations=400000
train.learning_rate=0.001
train.weight_decay=0.0001
train.batch_size=640
train.vae_input_dim=768
train.vae_n_cat_feats=0
train.vae_hidden_dims=[512, 256, 128]
train.vae_embed_dim=32
train.vae_codebook_size=256
train.vae_codebook_normalize=False
train.vae_sim_vq=False
train.save_model_every=5000
train.eval_every=5000
train.dataset_folder="dataset/amazon"
train.dataset=%data.processed.RecDataset.AMAZON
train.save_dir_root="out/rqvae/amazon/"
train.wandb_logging=True
train.commitment_weight=0.25
train.vae_n_layers=3
train.vae_codebook_mode=%modules.quantize.QuantizeForwardMode.ROTATION_TRICK
train.force_dataset_process=False
train.dataset_split="beauty"
train.do_eval=True
train.use_kmeans_init=True
# Bisect levers — revert a5367ed:
train.vae_decoder_normalize=False
train.vae_mlp_activation="relu"
